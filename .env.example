PORT=5000

# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq (console.groq.com) — used for feature extraction + AI execution/drafts
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gmail — dedicated account, NOT your personal inbox.
# Enable 2FA on the account, then Google Account -> Security -> App Passwords
GMAIL_USER=your-dedicated-account@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Base URL of the deployed frontend, used to build "open task" links in emails
APP_URL=https://your-app.vercel.app
