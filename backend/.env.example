PORT=5000

# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq (console.groq.com) — used for feature extraction + AI execution/drafts
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gmail — dedicated account, NOT your personal inbox.
# Enable 2FA on the account, then Google Account -> Security -> App Passwords
GMAIL_USER=your-dedicated-account@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Base URL of the deployed frontend, used to build "open task" links in emails
APP_URL=https://your-app.vercel.app

# --- Challenge 2: SLA-breach cascade rebalancing ---
# How often (ms) the background worker checks for stale tasks. Default 30000 (30s).
SLA_POLL_INTERVAL_MS=30000
# Set to "false" to disable the worker entirely (e.g. in tests).
SLA_MONITOR_ENABLED=true
# Where emergency "whole team saturated" alerts get emailed. Uses the same
# Gmail account/transporter as GMAIL_USER above.
# Fallback only: used when an employee has no manager_email set.
MANAGER_EMAIL=manager@example.com
